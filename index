<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daniel Demoz - Power BI Analytics Portfolio</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1f4e79 0%, #2d5a96 100%);
            min-height: 100vh;
            padding: 20px;
            color: #333;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        header {
            background: linear-gradient(135deg, #1f4e79 0%, #2d5a96 100%);
            color: white;
            padding: 40px 20px;
            text-align: center;
        }

        header h1 {
            font-size: 32px;
            margin-bottom: 10px;
            font-weight: 700;
        }

        header p {
            font-size: 16px;
            opacity: 0.95;
            margin-bottom: 10px;
        }

        header .subtitle {
            font-size: 14px;
            opacity: 0.85;
        }

        .slideshow-container {
            position: relative;
            background: #f8f9fa;
            padding: 30px 20px;
        }

        .slide {
            display: none;
            text-align: center;
            animation: fadeIn 0.5s;
        }

        .slide.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .slide-image {
            max-width: 100%;
            height: auto;
            max-height: 500px;
            border-radius: 8px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .slide-info {
            text-align: left;
            background: white;
            padding: 25px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .slide-category {
            display: inline-block;
            background: #1f4e79;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .slide-title {
            font-size: 24px;
            font-weight: 700;
            color: #1f4e79;
            margin-bottom: 12px;
        }

        .slide-description {
            font-size: 15px;
            line-height: 1.6;
            color: #555;
            margin-bottom: 15px;
        }

        .slide-metrics {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }

        .metric {
            background: #f0f5ff;
            padding: 12px;
            border-radius: 6px;
            border-left: 4px solid #1f4e79;
        }

        .metric-label {
            font-size: 12px;
            color: #666;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .metric-value {
            font-size: 16px;
            font-weight: 700;
            color: #1f4e79;
        }

        .controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 15px;
        }

        button {
            background: #1f4e79;
            color: white;
            border: none;
            padding: 10px 25px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.3s ease;
        }

        button:hover {
            background: #2d5a96;
        }

        button:disabled {
            background: #ccc;
            cursor: not-allowed;
        }

        .slide-counter {
            font-size: 14px;
            font-weight: 600;
            color: #555;
            min-width: 60px;
            text-align: center;
        }

        .dots {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #ddd;
            cursor: pointer;
            transition: background 0.3s ease;
        }

        .dot.active {
            background: #1f4e79;
        }

        .github-link {
            text-align: center;
            margin-bottom: 15px;
        }

        .github-link a {
            display: inline-block;
            background: #1f4e79;
            color: white;
            padding: 10px 20px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            transition: background 0.3s ease;
        }

        .github-link a:hover {
            background: #2d5a96;
        }

        footer {
            background: #f8f9fa;
            padding: 30px 20px;
            text-align: center;
            border-top: 1px solid #e0e0e0;
        }

        .footer-content {
            margin-bottom: 20px;
        }

        .footer-title {
            font-size: 18px;
            font-weight: 700;
            color: #1f4e79;
            margin-bottom: 15px;
        }

        .contact-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }

        .contact-links a {
            color: #1f4e79;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            transition: color 0.3s ease;
        }

        .contact-links a:hover {
            color: #2d5a96;
            text-decoration: underline;
        }

        .footer-note {
            font-size: 13px;
            color: #666;
            line-height: 1.6;
        }

        @media (max-width: 768px) {
            header h1 {
                font-size: 24px;
            }

            .slide-image {
                max-height: 350px;
            }

            .slide-title {
                font-size: 20px;
            }

            .controls {
                flex-direction: column;
                width: 100%;
            }

            button {
                width: 100%;
            }

            .slide-counter {
                width: 100%;
            }

            .contact-links {
                flex-direction: column;
                gap: 10px;
            }

            .contact-links a {
                display: block;
            }
        }

        .tech-badge {
            display: inline-block;
            background: #e8f0ff;
            color: #1f4e79;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
            margin-right: 6px;
            margin-top: 6px;
        }
    </style>
</head>
